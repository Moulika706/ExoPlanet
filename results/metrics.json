    "features": {
      "target": "koi_disposition",
      "group": "kepid",
      "label_order": [
        "CONFIRMED",
        "CANDIDATE",
        "FALSE POSITIVE"
      ],
      "core": [
        "koi_period",
        "koi_duration",
        "koi_depth",
        "koi_prad",
        "koi_teq",
        "koi_impact",
        "koi_insol",
        "koi_steff",
        "koi_slogg",
        "koi_srad",
        "koi_kepmag"
      ],
      "leakage": [
        "koi_score",
        "koi_pdisposition",
        "koi_fpflag_nt",
        "koi_fpflag_ss",
        "koi_fpflag_co",
        "koi_fpflag_ec"
      ]
    },
    "models": {
      "logistic_regression": {
        "max_iter": 2000
      },
      "random_forest": {
        "n_estimators": 400,
        "max_depth": null,
        "min_samples_leaf": 2
      },
      "xgboost": {
        "n_estimators": 400,
        "max_depth": 6,
        "learning_rate": 0.05,
        "subsample": 0.9,
        "colsample_bytree": 0.8,
        "reg_lambda": 1.0
      }
    },
    "calibration": {
      "method": "isotonic"
    },
    "conformal": {
      "alpha": 0.1,
      "score": "maxp",
      "mode": "marginal",
      "target_coverage": 0.9,
      "always_include_argmax": true
    },
    "report": {
      "top_k": 5,
      "random_seed": 42
    },
    "shap": {
      "perturbation": "tree_path",
      "background_size": 100,
      "global_max_rows": 2000
    },
    "stability": {
      "model": "xgboost",
      "max_rows": 1500
    },
    "cross_mission": {
      "toi": {
        "raw_csv": "data/raw/toi.csv",
        "retrieval_record": "data/raw/retrieval_toi.json",
        "disposition_column": "tfopwg_disp",
        "group_column": "tid"
      },
      "shared_features": [
        "koi_period",
        "koi_duration",
        "koi_depth",
        "koi_prad",
        "koi_teq",
        "koi_insol",
        "koi_steff",
        "koi_slogg",
        "koi_srad"
      ],
      "label_map": {
        "PC": "CANDIDATE",
        "APC": "CANDIDATE",
        "CP": "CONFIRMED",
        "KP": "CONFIRMED",
        "FP": "FALSE POSITIVE",
        "FA": "FALSE POSITIVE"
      },
      "calibration_fraction": 0.5
    }
  },
